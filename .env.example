# Module 3 demand prediction API (required when DEMAND_SOURCE=predicted)
PREDICTION_API_KEY=
PREDICTION_URL=https://module3-ml.onrender.com/predict

# predicted (default policy) | actual (baseline comparison only)
DEMAND_SOURCE=predicted

# Lab pacing when EXPERIMENT_FAST=0: sim-seconds per real second (20 ≈ 1 real sec = 20 sim sec)
SIMULATION_SPEED=20

# Batch experiments (screening/M3/finalists): 1=bench TraCI --fast, 0=Lab pacing above
EXPERIMENT_FAST=1

# Wall-clock seconds between Module 3 refresh when EXPERIMENT_FAST=0 (900 = 15 min)
POLICY_UPDATE_INTERVAL_REAL_S=900

# Sim-seconds between Module 3 refresh when EXPERIMENT_FAST=1 (900 = 15 sim-min)
POLICY_UPDATE_INTERVAL_SIM_S=900
