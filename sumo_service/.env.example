# Demand-prediction environment variables (external Module3 AI server).
#
# Copy this file to `.env` (same directory) to manage these locally:
#   cp .env.example .env
# `.env` is gitignored. Values here are loaded at startup by app/__init__.py
# (real environment variables / docker-compose `environment:` still take
# precedence over this file).

# --- Passenger incentive_limit fare cap ---

# Whether a passenger's incentive_limit caps the actual fare
# (final = min(meter_fare * surge, expected_fare + incentive_limit)).
# OFF by default: the incentive_limit request/response fields stay, but no cap
# is applied (full surge is charged). Set 1/true/yes/on to apply the cap.
INCENTIVE_LIMIT_ENABLED=0

# --- Live demand forecast (GET /simulation/demand-forecast) ---

# Turn on the live multi-horizon forecast. OFF by default.
# Accepts 1/true/yes/on. Requires PREDICTION_API_KEY when enabled.
DEMAND_FORECAST_ENABLED=0

# Number of 15-minute roll-forward buckets to predict (n+1 .. n+STEPS).
# Default 4 -> t+15, t+30, t+45, t+60.
DEMAND_FORECAST_STEPS=4

# --- Live predicted demand in surge/incentive (mirrors the experiment
#     demand_source=predicted path: same demand_by_h3 single-horizon call) ---

# Use external AI predicted demand as the surge/incentive input on the live
# server. Default "actual" (real counts). Set "predicted" to enable.
LIVE_DEMAND_SOURCE=actual

# Prediction call mode for live surge. Default "async" because surge is computed
# under a lock; "sync" would block REST/WS during the Module3 HTTP call.
LIVE_PREDICTION_MODE=async

# Prediction horizon in minutes (experiment default 15).
LIVE_PREDICTION_HORIZON_MIN=15

# Live fallback policy when Module3 is unavailable: last_prediction | actual | error.
# Default last_prediction so the live simulation never dies on a transient outage.
LIVE_PREDICTION_FALLBACK=last_prediction

# --- Module3 prediction client (shared by live forecast, live predicted surge,
#     and the experiment-only demand_source=predicted path) ---

# External Module3 predict endpoint.
PREDICTION_URL=https://module3-ml.onrender.com/predict

# API key sent as the X-API-Key header. REQUIRED for any prediction request
# (provider creation raises if missing). No default — set your real key here.
PREDICTION_API_KEY=

# HTTP request timeout in seconds (default 10.0).
PREDICTION_TIMEOUT_S=10.0

# Max retries on transient errors (429 / 5xx / network). Default 0 (no retry).
PREDICTION_RETRY_MAX=0

# Base exponential backoff between retries, in seconds (default 0.25).
PREDICTION_RETRY_BACKOFF_S=0.25
